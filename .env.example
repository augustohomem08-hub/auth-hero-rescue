# Variáveis de ambiente necessárias para rodar o projeto.
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA comite o arquivo `.env` real.

# Backend (Lovable Cloud / Supabase) — chaves públicas, expostas ao browser
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Mesmas chaves públicas, disponíveis no runtime de servidor (SSR)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Somente servidor — jamais expor ao client nem commitar.
# Em Lovable Cloud este valor é injetado automaticamente no runtime.
# SUPABASE_SERVICE_ROLE_KEY=
